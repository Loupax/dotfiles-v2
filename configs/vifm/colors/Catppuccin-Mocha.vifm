" Catppuccin Mocha for vifm.
" No official catppuccin/vifm port exists yet (as of 2026-08-21), so this is
" hand-built from the official Catppuccin Mocha palette (catppuccin.com/palette).
"
" Each group sets both:
"   - ctermfg/ctermbg: nearest xterm-256 approximation (used when the
"     terminal only advertises 256 colors)
"   - guifg/guibg: exact truecolor hex (used when the terminal advertises
"     direct/24-bit color, e.g. TERM=foot-direct)

highlight clear

" base       #1e1e2e (16)      mantle     #181825 (16)
" surface0   #313244 (59)      surface1   #45475a (59)     surface2 #585b70 (59)
" overlay0   #6c7086 (60)      subtext0   #a6adc8 (146)     text     #cdd6f4 (189)
" red        #f38ba8 (211)     green      #a6e3a1 (151)     yellow   #f9e2af (223)
" blue       #89b4fa (111)     mauve      #cba6f7 (183)     teal     #94e2d5 (116)
" peach      #fab387 (216)     lavender   #b4befe (147)

highlight Win         cterm=none ctermfg=189 ctermbg=16  gui=none guifg=#cdd6f4 guibg=#1e1e2e
highlight Directory   cterm=bold ctermfg=111 ctermbg=default gui=bold guifg=#89b4fa
highlight Link        cterm=bold ctermfg=116 ctermbg=default gui=bold guifg=#94e2d5
highlight BrokenLink  cterm=bold ctermfg=211 ctermbg=default gui=bold guifg=#f38ba8
highlight HardLink    cterm=none ctermfg=116 ctermbg=default gui=none guifg=#94e2d5
highlight Socket      cterm=bold ctermfg=183 ctermbg=default gui=bold guifg=#cba6f7
highlight Device      cterm=bold ctermfg=223 ctermbg=default gui=bold guifg=#f9e2af
highlight Fifo         cterm=bold ctermfg=116 ctermbg=default gui=bold guifg=#94e2d5
highlight Executable  cterm=bold ctermfg=151 ctermbg=default gui=bold guifg=#a6e3a1
highlight Selected    cterm=bold ctermfg=216 ctermbg=default gui=bold guifg=#fab387
highlight CurrLine    cterm=bold ctermfg=189 ctermbg=59  gui=bold guifg=#cdd6f4 guibg=#313244
highlight TopLine     cterm=none ctermfg=146 ctermbg=16  gui=none guifg=#a6adc8 guibg=#181825
highlight TopLineSel  cterm=bold ctermfg=16  ctermbg=111 gui=bold guifg=#1e1e2e guibg=#89b4fa
highlight StatusLine  cterm=none ctermfg=189 ctermbg=16  gui=none guifg=#cdd6f4 guibg=#181825
highlight WildBox     ctermfg=default ctermbg=default
highlight WildMenu    cterm=bold ctermfg=16  ctermbg=111 gui=bold guifg=#1e1e2e guibg=#89b4fa
highlight CmdLine     cterm=none ctermfg=189 ctermbg=16  gui=none guifg=#cdd6f4 guibg=#1e1e2e
highlight ErrorMsg    cterm=bold ctermfg=211 ctermbg=16  gui=bold guifg=#f38ba8 guibg=#1e1e2e
highlight Border      cterm=none ctermfg=59  ctermbg=16  gui=none guifg=#585b70 guibg=#1e1e2e
highlight OtherLine   cterm=none ctermfg=60  ctermbg=default gui=none guifg=#6c7086
highlight JobLine     cterm=bold ctermfg=16  ctermbg=216 gui=bold guifg=#1e1e2e guibg=#fab387
highlight SuggestBox  cterm=none ctermfg=189 ctermbg=59  gui=none guifg=#cdd6f4 guibg=#313244
highlight CmpMismatch cterm=bold ctermfg=16  ctermbg=211 gui=bold guifg=#1e1e2e guibg=#f38ba8
highlight CmpUnmatched cterm=bold ctermfg=16  ctermbg=151 gui=bold guifg=#1e1e2e guibg=#a6e3a1
highlight CmpBlank    ctermfg=default ctermbg=default
highlight AuxWin      ctermfg=default ctermbg=default
highlight TabLine     cterm=none ctermfg=60  ctermbg=16  gui=none guifg=#6c7086 guibg=#181825
highlight TabLineSel  cterm=bold ctermfg=16  ctermbg=147 gui=bold guifg=#1e1e2e guibg=#b4befe
highlight User1 ctermfg=default ctermbg=default
highlight User2 ctermfg=default ctermbg=default
highlight User3 ctermfg=default ctermbg=default
highlight User4 ctermfg=default ctermbg=default
highlight User5 ctermfg=default ctermbg=default
highlight User6 ctermfg=default ctermbg=default
highlight User7 ctermfg=default ctermbg=default
highlight User8 ctermfg=default ctermbg=default
highlight User9 ctermfg=default ctermbg=default
highlight User10 ctermfg=default ctermbg=default
highlight User11 ctermfg=default ctermbg=default
highlight User12 ctermfg=default ctermbg=default
highlight User13 ctermfg=default ctermbg=default
highlight User14 ctermfg=default ctermbg=default
highlight User15 ctermfg=default ctermbg=default
highlight User16 ctermfg=default ctermbg=default
highlight User17 ctermfg=default ctermbg=default
highlight User18 ctermfg=default ctermbg=default
highlight User19 ctermfg=default ctermbg=default
highlight User20 ctermfg=default ctermbg=default
highlight OtherWin ctermfg=default ctermbg=default
highlight LineNr      cterm=none ctermfg=60 ctermbg=default gui=none guifg=#6c7086
highlight OddLine ctermfg=default ctermbg=default
