# ~/.config/dwl/env -- machine-local, not committed to the repo.
#
# Sourced by startdwl before launching the compositor.
#
# PATH is the important one: dwl's keybinding spawns inherit the
# compositor's environment, which only has the system PATH. Scripts
# installed to ~/.local/bin (tofi_run_history, recorder, tmux-sessionizer)
# won't be found without this.
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Once waylock is packaged again, this goes back here too:
# export WAYLOCK_VIDEO="$HOME/Videos/lockscreen-1920x1080@25fps.bgra"
